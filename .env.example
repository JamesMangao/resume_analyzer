APP_NAME=LifeVault
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEVIATIONS=true

# Database Configuration (MySQL recommended for Stored Procedures fallback)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lifevault
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SELECTIVE_COOKIES=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Firebase Client configuration (Vite exposed frontend)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Firebase Admin SDK Configuration (Relative path from project root)
FIREBASE_CREDENTIALS="firebase-adminsdk.json"

# Mail settings (Required for Mention notifications)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@lifevault.com"
MAIL_FROM_NAME="${APP_NAME}"

# LLM Providers & API Keys
# OpenRouter (Life Story Memoir and Chatbot)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Groq (Shadow Self pattern analyzer - llama-3.3-70b-versatile)
GROQ_API_KEY="your-groq-api-key"

# Cerebras (Resume Coach and ATS Optimizer - llama3.1-8b)
CEREBRAS_API_KEY="your-cerebras-api-key"

# Gemini (Optional / Backup)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL=gemini-2.0-flash

# OCR Executable Paths (Tesseract & Poppler pdftoppm)
# For Windows, you can point to the precompiled binaries bundled in the repo:
# TESSERACT_PATH="D:\\LifeVault\\LifeVault\\poppler and tesseract\\Tesseract-OCR\\tesseract.exe"
# PDFTOPPM_PATH="D:\\LifeVault\\LifeVault\\poppler and tesseract\\poppler\\Library\\bin\\pdftoppm.exe"
# For Linux/Docker, install them via package manager:
TESSERACT_PATH="tesseract"
PDFTOPPM_PATH="pdftoppm"
